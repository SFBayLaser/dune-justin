# BASELINE: standard Cluster3D space point building (Cluster3DDUNE + SnippetHit3DBuilderDUNE),
# run in MakeSpacePointsOnly mode.
# Compare against standard_supera_dunevd10kt_1x8x6_3view_30deg.fcl (SpacePointBuilderDUNE + Fast tool).

#include "standard_supera_dunevd10kt_1x8x6_3view_30deg.fcl"

physics.producers.cluster3d:                                          @local::standard_cluster3ddune
physics.producers.cluster3d.HitFinderModuleLabel:                     ["gaushit"]
physics.producers.cluster3d.MakeSpacePointsOnly:                      true
physics.producers.cluster3d.Hit3DBuilderAlg:                          @local::standard_snippethit3dbuilderDUNE
physics.producers.cluster3d.Hit3DBuilderAlg.MaxHitChiSquare:          10.   # match FD baseline (tool default is 6)
physics.producers.cluster3d.Hit3DBuilderAlg.SaveMythicalPoints:       true
