#!/bin/bash
# justIN jobscript: single-muon generation + edep-sim (stage 1 of the TMS field-baseline workflow).
#
# Fires NEVENTS single muons at the TMS with a Geant4 GPS gun and runs edep-sim on the GDML given by GDML_URL.
# The magnetic field is whatever that GDML defines (BField tags, or an ArbBField map named in an auxiliary tag).
# Stage 2 (TMS/tms.jobscript) reconstructs the output.
#
# Environment (set per stage in the workflow config):
#   NEVENTS        muons per job
#   GDML_URL       geometry file, fetched with curl (pin it to a commit, not a branch)
#   GEOM_TAG       short geometry label used in the output name
#   FIELD_TAG      short field label used in the output name (e.g. bfieldtags, mapper)
#   SEED_BASE      added to the job's random seed, which is SEED_BASE + 10000 * workflow id + job number, so
#                  two workflows never share seeds (and two jobs of one workflow never do)
# Optional:
#   CHARGE         mu-, mu+, or alternate (default: even job numbers mu-, odd mu+)
#   KE_MIN_MEV / KE_MAX_MEV      kinetic energy, flat between (default 500 / 5000)
#   START_X_MM / START_Y_MM / START_Z_MM   centre of the start rectangle (default 0 / -2202 / 11000)
#   HALF_X_MM / HALF_Y_MM        half-size of the rectangle (default 3000 / 1000)
#   CONE_DEG       half-angle of the direction cone about +z (default 10)
#   GDML_SHA256    expected checksum of the GDML
#   MAP_SOURCE    field-map file already on the worker (e.g. under the cvmfs directory shipped with
#                  justin-cvmfs-upload); linked into the working directory. Use this for a large map.
#   MAP_URL        alternatively, a field-map file fetched with curl (only for a small file)
#   MAP_SHA256     expected checksum of the map
#                  edep-sim opens an ArbBField map by the name written in the GDML's auxiliary tag, relative to
#                  where it runs. The job reads that name from the GDML and places the map under it, so the file
#                  you supply may have any name. A GDML that names a map needs MAP_SOURCE or MAP_URL, and a GDML
#                  without one must not be given a map: either mismatch stops the job before edep-sim runs.
#   EDEPSIM_VERSION  (default v3_2_0e)
#
# Output (picked up by the stage's output pattern):
#   muon_<mum|mup>_<GEOM_TAG>_<FIELD_TAG>_w<workflow id>_<jobnum>.edep.root
# The workflow id is part of the name because the job number restarts at 1 in every workflow and Rucio file names
# must be unique.

echo "=== muon edep-sim job starting ==="
echo "Host: $(hostname)"
echo "PWD:  $(pwd -P)"
echo "JUSTIN_PATH=${JUSTIN_PATH:-unset}"

workdir="$(pwd -P)"

if [[ -z "${JUSTIN_PATH:-}" ]]; then
  echo "ERROR: JUSTIN_PATH is not set (not running under justIN wrapper?)" >&2
  exit 2
fi

for v in NEVENTS GDML_URL GEOM_TAG FIELD_TAG SEED_BASE; do
  if [[ -z "${!v:-}" ]]; then
    echo "ERROR: $v is not set" >&2
    exit 3
  fi
done

# ----------------------------------------------------------------------
# The Monte Carlo "counter file": its DID ends in the job number
# ----------------------------------------------------------------------
alloc="$("$JUSTIN_PATH/justin-get-file")"
if [[ -z "$alloc" ]]; then
  echo "No more inputs allocated (workflow complete). Exiting cleanly."
  exit 0
fi

did="$(echo "$alloc" | awk '{print $1}' | tr -d '\r' | xargs)"
echo "Allocated: $alloc"
# The counter DID looks like monte-carlo-<workflow id>-<job number>, e.g. monte-carlo-022454-000004
if [[ ! "$did" =~ -([0-9]+)-([0-9]+)$ ]]; then
  echo "ERROR: cannot read the workflow id and job number from the counter DID '$did'" >&2
  exit 3
fi
wfid_str="${BASH_REMATCH[1]}"
jobnum=$((10#${BASH_REMATCH[2]}))
wfid=$((10#$wfid_str))
seed=$(( (SEED_BASE + 10000 * wfid + jobnum) % 2147483647 ))   # edep-sim takes an int

charge="${CHARGE:-alternate}"
if [[ "$charge" == "alternate" ]]; then
  if (( jobnum % 2 == 0 )); then charge="mu-"; else charge="mu+"; fi
fi
case "$charge" in
  mu-) ctag=mum ;;
  mu+) ctag=mup ;;
  *) echo "ERROR: CHARGE must be mu-, mu+ or alternate (got '$charge')" >&2; exit 3 ;;
esac

ke_min="${KE_MIN_MEV:-500}"
ke_max="${KE_MAX_MEV:-5000}"
sx="${START_X_MM:-0}"
sy="${START_Y_MM:--2202}"
sz="${START_Z_MM:-11000}"
hx="${HALF_X_MM:-3000}"
hy="${HALF_Y_MM:-1000}"
cone="${CONE_DEG:-10}"
edepsim_version="${EDEPSIM_VERSION:-v3_2_0e}"

echo "workflow $wfid_str  job $jobnum  seed $seed  $charge  KE ${ke_min}-${ke_max} MeV  events $NEVENTS"

# ----------------------------------------------------------------------
# Geometry (and, if given, the field map)
# ----------------------------------------------------------------------
gdml="${workdir}/$(basename "$GDML_URL")"
curl -fsSL -o "$gdml" "$GDML_URL" || { echo "ERROR: could not fetch $GDML_URL" >&2; exit 4; }
if [[ -n "${GDML_SHA256:-}" ]]; then
  got="$(sha256sum "$gdml" | awk '{print $1}')"
  if [[ "$got" != "$GDML_SHA256" ]]; then
    echo "ERROR: GDML checksum $got does not match GDML_SHA256 $GDML_SHA256" >&2
    exit 4
  fi
fi
ls -l "$gdml"

# The map the GDML asks for, if any: <auxiliary auxtype="ArbBField" auxvalue="NAME"/>
required_maps="$(grep -oE 'auxtype="ArbBField"[[:space:]]+auxvalue="[^"]+"' "$gdml" | sed -E 's/.*auxvalue="([^"]+)".*/\1/' | sort -u)"
n_required=$(printf '%s' "$required_maps" | grep -c .)
if (( n_required > 1 )); then
  echo "ERROR: the GDML names more than one field map: $(echo $required_maps)" >&2
  exit 6
fi
if [[ -n "${MAP_SOURCE:-}${MAP_URL:-}" ]]; then
  if (( n_required == 0 )); then
    echo "ERROR: a field map was supplied but the GDML has no ArbBField tag, so edep-sim would ignore it" >&2
    exit 6
  fi
  map_target="${workdir}/${required_maps}"
  if [[ -n "${MAP_SOURCE:-}" ]]; then
    [[ -r "$MAP_SOURCE" ]] || { echo "ERROR: cannot read MAP_SOURCE $MAP_SOURCE" >&2; exit 4; }
    map_file="$MAP_SOURCE"
    ln -sf "$MAP_SOURCE" "$map_target" || cp "$MAP_SOURCE" "$map_target" || exit 4
  else
    map_file="$map_target"
    curl -fsSL -o "$map_target" "$MAP_URL" || { echo "ERROR: could not fetch $MAP_URL" >&2; exit 4; }
  fi
  if [[ -n "${MAP_SHA256:-}" ]]; then
    got="$(sha256sum "$map_file" | awk '{print $1}')"
    if [[ "$got" != "$MAP_SHA256" ]]; then
      echo "ERROR: field map checksum $got does not match MAP_SHA256 $MAP_SHA256" >&2
      exit 4
    fi
  fi
  echo "Field map: $map_file as $(basename "$map_target")"
  ls -lL "$map_target"
elif (( n_required == 1 )); then
  echo "ERROR: the GDML names the field map '$required_maps' but MAP_SOURCE and MAP_URL are not set" >&2
  exit 6
fi

# ----------------------------------------------------------------------
# edep-sim environment
# ----------------------------------------------------------------------
source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh > /dev/null 2>&1
setup edepsim "$edepsim_version" -q e26:prof
if ! command -v edep-sim > /dev/null; then
  echo "ERROR: edep-sim $edepsim_version is not available" >&2
  exit 5
fi
echo "edep-sim: $(command -v edep-sim)"

# ----------------------------------------------------------------------
# Macro: the ND_Production physics settings plus a GPS muon gun.
# /gps/ang/type iso emits along -(sin t cos f, sin t sin f, cos t), so +z needs t in [180-cone, 180].
# ----------------------------------------------------------------------
macro="${workdir}/muon_gun.mac"
cat > "$macro" <<EOF
/control/macroPath /cvmfs/dune.opensciencegrid.org/products/dune/edepsim/${edepsim_version}/Linux64bit+3.10-2.17-e26-prof/lib/EDepSim
/control/execute edepsim-defaults-1.0.mac
/edep/phys/ionizationModel 0
/edep/db/set/neutronThreshold 0 MeV
/edep/db/set/lengthThreshold 0 mm
/edep/db/set/gammaThreshold 0 MeV
/edep/db/set/saveAllPrimTraj true
/edep/random/randomSeed ${seed}
/edep/update
/generator/kinematics/set gps
/generator/position/set free
/generator/time/set free
/generator/count/fixed/number 1
/generator/count/set fixed
/generator/add
/gps/particle ${charge}
/gps/ene/type Lin
/gps/ene/min ${ke_min} MeV
/gps/ene/max ${ke_max} MeV
/gps/ene/gradient 0
/gps/ene/intercept 1
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/centre ${sx} ${sy} ${sz} mm
/gps/pos/halfx ${hx} mm
/gps/pos/halfy ${hy} mm
/gps/ang/type iso
/gps/ang/mintheta $(awk -v c="$cone" 'BEGIN{print 180-c}') deg
/gps/ang/maxtheta 180 deg
EOF

# ----------------------------------------------------------------------
# Run edep-sim in the working directory (so a field-map name in the GDML resolves)
# ----------------------------------------------------------------------
outname="muon_${ctag}_${GEOM_TAG}_${FIELD_TAG}_w${wfid_str}_$(printf '%06d' "$jobnum")"
outfile="${workdir}/${outname}.edep.root"
log="${workdir}/${outname}.edep.log"

start=$(date +%s)
edep-sim -C -g "$gdml" -o "$outfile" -e "$NEVENTS" "$macro" > "$log" 2>&1
rc=$?
echo "edep-sim exit $rc after $(( $(date +%s) - start )) s"
tail -5 "$log"

# A field map that cannot be opened is logged by edep-sim ("Can't read <file>"); with this version it then crashes
# on the first event, but report the cause first either way.
if grep -q "Can't read" "$log"; then
  echo "ERROR: edep-sim could not read a field map:" >&2
  grep "Can't read" "$log" >&2
  exit 6
fi

if [[ $rc -ne 0 ]]; then
  echo "ERROR: edep-sim failed with status $rc" >&2
  exit $rc
fi

if [[ ! -s "$outfile" ]]; then
  echo "ERROR: edep-sim output was not produced or is empty" >&2
  exit 7
fi
ls -lh "$outfile" "$log"

# Tell justIN that the allocated counter file was successfully processed.
echo "$did" >> "$workdir/justin-processed-dids.txt"
echo "Wrote processed DID: $did"
echo "=== muon edep-sim job completed successfully ==="
exit 0
