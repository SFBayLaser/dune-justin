{
  "workflow": {
    "description": "TMS single-muon step A (evenx map, polarity corrected): mapped field simulation (ArbBField), built-in reco field",
    "monte_carlo": 100
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 30,
    "max_distance": 60,
    "limit_sites": false
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/muon_edepsim.jobscript",
      "wall_seconds": 3600,
      "rss_mib": 2000,
      "env": {
        "NEVENTS": "2000",
        "SEED_BASE": "200000",
        "CHARGE": "alternate",
        "GEOM_TAG": "cleannew",
        "FIELD_TAG": "fieldmapx",
        "GDML_URL": "file:///cvmfs/fifeuser3.opensciencegrid.org/sw/dune/15eb575233c303574ab5e4f77114296245f65f7c/fieldmap/nd_hall_80layers_MAPPED_evenx.gdml",
        "GDML_SHA256": "060d8eb6900953ebbab206781ae852e75dd558cf392dda3fe769593b308125f9",
        "MAP_SOURCE": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/15eb575233c303574ab5e4f77114296245f65f7c/fieldmap/Mapper_global_evenx.txt",
        "MAP_SHA256": "ef38fb823a5f6669c3aaacc3e99d60c4eecb6b21c14a64c5287e467953de288c"
      },
      "output_pattern_next_stage": "*.edep.root"
    },
    {
      "id": 2,
      "jobscript": "TMS/tms_muon_reco_tuple.jobscript",
      "wall_seconds": 7200,
      "rss_mib": 4000,
      "tarfile_dir": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/e77a4b378328cb20a3a3a49b2c2f472994f3f36d",
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_muonmapAx_v01",
        "TUPLE_SCRIPT_URL": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/TMS/muon_tuple.py"
      },
      "output_patterns": [
        "*_tuple.root",
        "*_convert.log"
      ]
    }
  ]
}
