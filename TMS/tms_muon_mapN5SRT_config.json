{
  "workflow": {
    "description": "TMS single-muon 200k: reco only of the 1 T-equivalent re-laid map (N5S) edep files (workflow 23044) with the range-table momentum (MomentumFromRange=true, dune-tms with PR #352), map-based reco field",
    "mql": "files from usertests:fnal-w23044s1p1"
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 30,
    "max_distance": 60,
    "limit_sites": false,
    "tarfile_dir": "/cvmfs/fifeuser1.opensciencegrid.org/sw/dune/b6d4ea731894d84a3788f4d5671680c9bcec3984"
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/tms_muon_reco_tuple.jobscript",
      "wall_seconds": 10800,
      "rss_mib": 6000,
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_muonmapN5SRT_v01",
        "MOMENTUM_FROM_RANGE": "true",
        "TUPLE_SCRIPT_URL": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/TMS/muon_tuple.py",
        "FIELD_MAP_SOURCE": "/cvmfs/fifeuser2.opensciencegrid.org/sw/dune/ba64c7cc102b6c6dd9538e9ead74067a1b953d1e/fieldmap/Mapper_global_100_100_05_RELAID_1T.txt",
        "FIELD_MAP_SHA256": "b65d140e7bd16bc370f43143ed3306a819c48357ea5a063eff73227c278d2f44"
      },
      "output_patterns": [
        "*_tuple.root",
        "*_convert.log"
      ]
    }
  ]
}
