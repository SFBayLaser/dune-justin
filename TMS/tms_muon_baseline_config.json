{
  "workflow": {
    "description": "TMS single-muon baseline (100k muons): CLEAN_NEW_GEOMETRY with BField tags, built-in reco field",
    "monte_carlo": 50
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 30,
    "max_distance": 60,
    "limit_sites": false
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/muon_edepsim.jobscript",
      "wall_seconds": 3600,
      "rss_mib": 2000,
      "env": {
        "NEVENTS": "2000",
        "SEED_BASE": "200000",
        "CHARGE": "alternate",
        "GEOM_TAG": "cleannew",
        "FIELD_TAG": "bfieldtags",
        "GDML_URL": "https://raw.githubusercontent.com/DUNE/dune-tms/0a059d4eb484c146d41857377e5d940bc970f976/mapper_integration/nd_hall_with_lar_tms_nosand_CLEAN_NEW_GEOMETRY.gdml",
        "GDML_SHA256": "96825bba242f3bf372faa69da7dc4547c95a6d39e669d0ea2abc8f2626069e24"
      },
      "output_pattern_next_stage": "*.edep.root"
    },
    {
      "id": 2,
      "jobscript": "TMS/tms_muon_reco_tuple.jobscript",
      "wall_seconds": 7200,
      "rss_mib": 4000,
      "tarfile_dir": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/e77a4b378328cb20a3a3a49b2c2f472994f3f36d",
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_muonbase_v02",
        "TUPLE_SCRIPT_URL": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/TMS/muon_tuple.py"
      },
      "output_patterns": [
        "*_tuple.root",
        "*_convert.log"
      ]
    }
  ]
}
