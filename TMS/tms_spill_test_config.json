{
  "workflow": {
    "description": "TMS MiniProdN5p3 FHC spill Processing",
    "mql": "files from neardet-lar-tms-sand:MiniProdN5p3_NDComplex_FHC_spill_full_sanddrift"
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 4,
    "max_distance": 60,
    "limit_sites": false,
    "tarfile_dir": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/207bf0f82ad82acd335acf3956dbdfc9c618d03d"
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/tms.jobscript",
      "wall_seconds": 28800,
      "rss_mib": 4000,
      "lifetime_days": 4,
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_Cluster3D_v01"
      },
      "output_patterns": [
        "*_RecoCandidates.root",
        "*_Readout.root",
        "*_convert.log"
      ]
    }
  ]
}
