{
  "workflow": {
    "description": "TMS single-muon small test (5000 muons): revised 100x100x5 mm map (Mapper_global_100_100_05_VALIDATION.txt), mapped sim then map-based reco, fit momentum",
    "monte_carlo": 5
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 30,
    "max_distance": 60,
    "limit_sites": false
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/muon_edepsim.jobscript",
      "wall_seconds": 3600,
      "rss_mib": 3000,
      "env": {
        "NEVENTS": "1000",
        "SEED_BASE": "300000",
        "CHARGE": "alternate",
        "GEOM_TAG": "cleannew",
        "FIELD_TAG": "fieldmapn5",
        "GDML_URL": "file:///cvmfs/fifeuser4.opensciencegrid.org/sw/dune/28730486d7f18d08b993d9cd0f1a766a436a130a/fieldmap/nd_hall_80layers_MAPPED_n5.gdml",
        "GDML_SHA256": "0062b7cef70e35033a044bb8f0605999c0cf19970cb7e9f478ab0c136796ee49",
        "MAP_SOURCE": "/cvmfs/fifeuser4.opensciencegrid.org/sw/dune/28730486d7f18d08b993d9cd0f1a766a436a130a/fieldmap/Mapper_global_100_100_05_VALIDATION.txt",
        "MAP_SHA256": "a297c88a823f92fed7a718ac080b3f4ed8e89c6f9ebac07f7511d31d24e43203"
      },
      "output_pattern_next_stage": "*.edep.root"
    },
    {
      "id": 2,
      "jobscript": "TMS/tms_muon_reco_tuple.jobscript",
      "wall_seconds": 7200,
      "rss_mib": 6000,
      "tarfile_dir": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/e77a4b378328cb20a3a3a49b2c2f472994f3f36d",
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_muonmapN5Fit_v01",
        "MOMENTUM_FROM_RANGE": "false",
        "TUPLE_SCRIPT_URL": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/TMS/muon_tuple.py",
        "FIELD_MAP_SOURCE": "/cvmfs/fifeuser4.opensciencegrid.org/sw/dune/28730486d7f18d08b993d9cd0f1a766a436a130a/fieldmap/Mapper_global_100_100_05_VALIDATION.txt",
        "FIELD_MAP_SHA256": "a297c88a823f92fed7a718ac080b3f4ed8e89c6f9ebac07f7511d31d24e43203"
      },
      "output_patterns": [
        "*_tuple.root",
        "*_convert.log"
      ]
    }
  ]
}
