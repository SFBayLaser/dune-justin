{
  "workflow": {
    "description": "TMS MiniProdN5p3 FHC spill processing for the slicing study, run C: legacy per-hit detector response (single stage)",
    "mql": "files from neardet-lar-tms-sand:MiniProdN5p3_NDComplex_FHC_spill_full_sanddrift"
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 4,
    "max_distance": 60,
    "limit_sites": false,
    "tarfile_dir": "/cvmfs/fifeuser4.opensciencegrid.org/sw/dune/0c65bf610091ce02ef1c2f1711d9180949f074f3"
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/tms_legacy.jobscript",
      "wall_seconds": 28800,
      "rss_mib": 4000,
      "lifetime_days": 14,
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_SlicingC_Legacy_v02"
      },
      "output_patterns": [
        "*_Readout.root",
        "*_RecoCandidates.root",
        "*_convert.log"
      ]
    }
  ]
}
