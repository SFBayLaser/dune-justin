#!/bin/bash
# justIN jobscript: stage 2 of the single-muon TMS field baseline. Runs ConvertToTMSTree on one single-muon edep-sim
# file (stage 1, TMS/muon_edepsim.jobscript) and reduces the result to a small flat tuple (TMS/muon_tuple.py).
#
# The tuple is made in this job, not in a later stage, because the per-muon truth (efficiency, exiting muons) comes
# from the edep-sim file and the tuple joins it to the reco output. Only the tuple and the logs are uploaded: the
# RecoCandidates and Readout files stay in the job's scratch area.
#
# The reco runs with [Recon.Cluster3D] MomentumFromRange = false, whatever the packaged justIN config says, so that
# Reco_Tree_C3D.Momentum is the Kalman curvature momentum for every track. The range estimate is taken separately
# from EnergyRange in the tuple.
#
# The dune-tms development build is supplied with justin-cvmfs-upload (INPUT_TAR_DIR_LOCAL contains dune-tms/).
# Environment:
#   TMS_PRODUCTION_TAG   label added to the output names
#   TUPLE_SCRIPT_URL     where to fetch muon_tuple.py (e.g. the raw GitHub URL of dune-justin/TMS/muon_tuple.py)
# Optional:
#   TMS_TOML_SOURCE      reco config to start from (default $TMS_DIR/config/justin/TMS_Config_Cluster3D.toml)
#   FIELD_MAP_SOURCE     field map for the reco's field model, a file already on the worker (e.g. under the cvmfs
#                        directory shipped with justin-cvmfs-upload); linked into the working directory
#   FIELD_MAP_URL        alternatively, fetched with curl (only for a small file)
#   FIELD_MAP_SHA256     expected checksum of the map. Use the same map as the simulation, in the same workflow.
#                        Needs a dune-tms build with MapFieldModel (branch feature/cluster3d-map-field-model);
#                        a build without it would ignore the setting, so the job stops if the log does not show
#                        the map being used. Without a map the reco uses its built-in +-1 T field model.
#
# Outputs:  <base>_<tag>_tuple.root   <base>_<tag>_convert.log

echo "=== TMS single-muon reco + tuple job starting ==="
echo "Host: $(hostname)"
echo "PWD:  $(pwd -P)"
echo "JUSTIN_PATH=${JUSTIN_PATH:-unset}"

workdir="$(pwd -P)"

if [[ -z "${JUSTIN_PATH:-}" ]]; then
  echo "ERROR: JUSTIN_PATH is not set (not running under justIN wrapper?)" >&2
  exit 2
fi
for v in TMS_PRODUCTION_TAG TUPLE_SCRIPT_URL; do
  if [[ -z "${!v:-}" ]]; then
    echo "ERROR: $v is not set" >&2
    exit 1
  fi
done

# ----------------------------------------------------------------------
# Allocate one edep-sim input
# ----------------------------------------------------------------------
alloc="$("$JUSTIN_PATH/justin-get-file")"
if [[ -z "$alloc" ]]; then
  echo "No input file allocated by justIN"
  exit 0
fi

did="$(echo "$alloc" | awk '{print $1}')"
pfn="$(echo "$alloc" | awk '{print $2}')"
rse="$(echo "$alloc" | awk '{print $3}')"
echo "Input: did=$did pfn=$pfn rse=$rse"

input_name=$(basename "${did#*:}")
local_input="${workdir}/${input_name}"
xrdcp -f "$pfn" "$local_input"
if [ $? -ne 0 ] || [ ! -s "$local_input" ]; then
  echo "ERROR: Failed to copy input file locally"
  exit 1
fi
ls -lh "$local_input"

# ----------------------------------------------------------------------
# dune-tms currently requires Scientific Linux 7
# ----------------------------------------------------------------------
if ! grep -q "Scientific Linux" /etc/redhat-release 2>/dev/null; then
  echo "ERROR: not an SL7 environment ($(cat /etc/redhat-release 2>/dev/null))" >&2
  exit 3
fi

TMS_BUILD="${INPUT_TAR_DIR_LOCAL:-}/dune-tms"
if [[ -z "${INPUT_TAR_DIR_LOCAL:-}" || ! -f "$TMS_BUILD/setup.sh" ]]; then
  echo "ERROR: INPUT_TAR_DIR_LOCAL (${INPUT_TAR_DIR_LOCAL:-unset}) does not contain dune-tms/setup.sh" >&2
  exit 4
fi
echo "Using packaged dune-tms build: $TMS_BUILD"
cd "$TMS_BUILD" || exit 4
# setup.sh intentionally sets TMS_DIR from PWD.
source setup.sh
setup_rc=$?
cd "$workdir" || exit 4
if [[ $setup_rc -ne 0 ]]; then
  echo "ERROR: dune-tms setup.sh failed with status $setup_rc" >&2
  exit $setup_rc
fi
echo "TMS_DIR=${TMS_DIR:-unset}"
command -v ConvertToTMSTree || { echo "ERROR: ConvertToTMSTree not on PATH" >&2; exit 5; }
command -v python3 > /dev/null || { echo "ERROR: python3 not available for the tuple step" >&2; exit 5; }

# ----------------------------------------------------------------------
# Reco config: the packaged justIN one with MomentumFromRange forced off
# ----------------------------------------------------------------------
toml_source="${TMS_TOML_SOURCE:-$TMS_DIR/config/justin/TMS_Config_Cluster3D.toml}"
if [[ ! -f "$toml_source" ]]; then
  echo "ERROR: TMS configuration not found: $toml_source" >&2
  exit 6
fi
export TMS_TOML="${workdir}/TMS_Config_curvature.toml"
sed 's/^\([[:space:]]*MomentumFromRange[[:space:]]*=[[:space:]]*\).*/\1false/' "$toml_source" > "$TMS_TOML"
if ! grep -qE '^[[:space:]]*MomentumFromRange[[:space:]]*=[[:space:]]*false' "$TMS_TOML"; then
  echo "ERROR: could not set MomentumFromRange = false in $toml_source" >&2
  exit 6
fi
echo "TMS_TOML=$TMS_TOML (from $toml_source)"

# ----------------------------------------------------------------------
# Field map for the reco (optional): written into the config as [Recon.Cluster3D] FieldMapFile
# ----------------------------------------------------------------------
map_requested=0
map_name=""
if [[ -n "${FIELD_MAP_SOURCE:-}${FIELD_MAP_URL:-}" ]]; then
  map_requested=1
  map_name="$(basename "${FIELD_MAP_SOURCE:-$FIELD_MAP_URL}")"
  map_local="${workdir}/${map_name}"
  if [[ -n "${FIELD_MAP_SOURCE:-}" ]]; then
    [[ -r "$FIELD_MAP_SOURCE" ]] || { echo "ERROR: cannot read FIELD_MAP_SOURCE $FIELD_MAP_SOURCE" >&2; exit 6; }
    ln -sf "$FIELD_MAP_SOURCE" "$map_local" || cp "$FIELD_MAP_SOURCE" "$map_local" || exit 6
  else
    curl -fsSL -o "$map_local" "$FIELD_MAP_URL" || { echo "ERROR: could not fetch $FIELD_MAP_URL" >&2; exit 6; }
  fi
  if [[ -n "${FIELD_MAP_SHA256:-}" ]]; then
    got="$(sha256sum "$map_local" | awk '{print $1}')"
    if [[ "$got" != "$FIELD_MAP_SHA256" ]]; then
      echo "ERROR: field map checksum $got does not match FIELD_MAP_SHA256 $FIELD_MAP_SHA256" >&2
      exit 6
    fi
  fi
  # replace any FieldMapFile line, then add ours under [Recon.Cluster3D]
  grep -v '^[[:space:]]*FieldMapFile[[:space:]]*=' "$TMS_TOML" > "${TMS_TOML}.tmp"
  awk -v f="$map_local" '{print} /^[[:space:]]*\[Recon\.Cluster3D\][[:space:]]*$/ {print "    FieldMapFile = \"" f "\""}' \
      "${TMS_TOML}.tmp" > "$TMS_TOML"
  rm -f "${TMS_TOML}.tmp"
  if ! grep -q "^[[:space:]]*FieldMapFile = \"$map_local\"" "$TMS_TOML"; then
    echo "ERROR: could not set FieldMapFile in $TMS_TOML (no [Recon.Cluster3D] section?)" >&2
    exit 6
  fi
  echo "Field map for the reco: $map_local"
  ls -lL "$map_local"
fi

# ----------------------------------------------------------------------
# Reco
# ----------------------------------------------------------------------
base=$(basename "${did#*:}" .root)
outbase="${base}_${TMS_PRODUCTION_TAG}"
export ND_PRODUCTION_TMSRECO_OUTFILE="${workdir}/${outbase}_RecoCandidates.root"
export ND_PRODUCTION_TMSRECOREADOUT_OUTFILE="${workdir}/${outbase}_Readout.root"
convert_log="${workdir}/${outbase}_convert.log"

start=$(date +%s)
ConvertToTMSTree "$local_input" > "$convert_log" 2>&1
rc=$?
echo "ConvertToTMSTree exit $rc after $(( $(date +%s) - start )) s"
tail -5 "$convert_log" || true
if [[ $rc -ne 0 ]]; then
  echo "ERROR: ConvertToTMSTree failed with status $rc" >&2
  exit $rc
fi
if [[ ! -s "$ND_PRODUCTION_TMSRECO_OUTFILE" ]]; then
  echo "ERROR: RecoCandidates output was not produced or is empty" >&2
  exit 7
fi

# Which field model the reco really used (builds with MapFieldModel print this line; older ones print nothing)
field_model_line="$(grep -a -m1 'Cluster3D field model' "$convert_log")"
echo "Reco field model: ${field_model_line:-no model line in the log (build without MapFieldModel)}"
# the same, without the per-job path, for the tuple metadata
field_model_meta="$(echo "$field_model_line" | sed -E 's|map [^ ]*/([^/ ]+) |map \1 |')"
if [[ $map_requested -eq 1 ]] && ! echo "$field_model_line" | grep -q "field model: map"; then
  echo "ERROR: a field map was requested but the reco log does not show it being used; the dune-tms build in" >&2
  echo "       INPUT_TAR_DIR_LOCAL probably lacks MapFieldModel and ran with the built-in field" >&2
  exit 10
fi

# ----------------------------------------------------------------------
# Tuple: edep-sim truth for every muon thrown, joined to the reco tracks
# ----------------------------------------------------------------------
tuple_script="${workdir}/muon_tuple.py"
curl -fsSL -o "$tuple_script" "$TUPLE_SCRIPT_URL" || { echo "ERROR: could not fetch $TUPLE_SCRIPT_URL" >&2; exit 8; }
tuple_out="${workdir}/${outbase}_tuple.root"
python3 "$tuple_script" "$local_input" "$ND_PRODUCTION_TMSRECO_OUTFILE" "$tuple_out" \
    --meta "edep_file=$input_name" \
    --meta "reco_field_model=${field_model_meta:-built-in (no model line)}" \
    --meta "reco_field_map=${map_name:-none}" \
    --meta "reco_field_map_sha256=${FIELD_MAP_SHA256:-unknown}" \
    --meta "momentum_from_range=false" \
    --meta "tms_build=${INPUT_TAR_DIR_LOCAL}" \
    --meta "tms_production_tag=${TMS_PRODUCTION_TAG}"
rc=$?
if [[ $rc -ne 0 || ! -s "$tuple_out" ]]; then
  echo "ERROR: tuple step failed (exit $rc)" >&2
  exit 9
fi

echo "Outputs:"
ls -lh "$tuple_out" "$convert_log"

# Keep only what is uploaded; the big intermediates are not needed any more.
rm -f "$local_input" "$ND_PRODUCTION_TMSRECO_OUTFILE" "$ND_PRODUCTION_TMSRECOREADOUT_OUTFILE" "$tuple_script"

echo "$did" >> "$workdir/justin-processed-dids.txt"
echo "Wrote processed DID: $did"
echo "=== TMS single-muon reco + tuple job completed successfully ==="
exit 0
