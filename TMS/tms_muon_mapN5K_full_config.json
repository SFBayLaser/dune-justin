{
  "workflow": {
    "description": "TMS single-muon 200k: approx 30 kA-turns re-laid map (N5K), mapped sim then map-based reco, fit momentum",
    "monte_carlo": 100
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 30,
    "max_distance": 60,
    "limit_sites": false
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "TMS/muon_edepsim.jobscript",
      "wall_seconds": 7200,
      "rss_mib": 3000,
      "env": {
        "NEVENTS": "2000",
        "SEED_BASE": "700000",
        "CHARGE": "alternate",
        "GEOM_TAG": "cleannew",
        "FIELD_TAG": "fieldmapn5k",
        "GDML_URL": "file:///cvmfs/fifeuser2.opensciencegrid.org/sw/dune/8c11608ea3f7e5a707b61eb803c5fecefd85b053/fieldmap/nd_hall_80layers_MAPPED_n5k.gdml",
        "GDML_SHA256": "f83eb12450a7c535a8292612c30a524a38cabc35a3c14045e6424197b4b9ca1e",
        "MAP_SOURCE": "/cvmfs/fifeuser2.opensciencegrid.org/sw/dune/8c11608ea3f7e5a707b61eb803c5fecefd85b053/fieldmap/Mapper_global_100_100_05_RELAID_30kA.txt",
        "MAP_SHA256": "447f183345e4b60e8a99b098f1bfda21918d1ac50a69b8c05a680bed134a8c55"
      },
      "output_pattern_next_stage": "*.edep.root"
    },
    {
      "id": 2,
      "jobscript": "TMS/tms_muon_reco_tuple.jobscript",
      "wall_seconds": 10800,
      "rss_mib": 6000,
      "tarfile_dir": "/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/e77a4b378328cb20a3a3a49b2c2f472994f3f36d",
      "env": {
        "TMS_PRODUCTION_TAG": "TMSReco_muonmapN5KFull_v01",
        "MOMENTUM_FROM_RANGE": "false",
        "TUPLE_SCRIPT_URL": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/TMS/muon_tuple.py",
        "FIELD_MAP_SOURCE": "/cvmfs/fifeuser2.opensciencegrid.org/sw/dune/8c11608ea3f7e5a707b61eb803c5fecefd85b053/fieldmap/Mapper_global_100_100_05_RELAID_30kA.txt",
        "FIELD_MAP_SHA256": "447f183345e4b60e8a99b098f1bfda21918d1ac50a69b8c05a680bed134a8c55"
      },
      "output_patterns": [
        "*_tuple.root",
        "*_convert.log"
      ]
    }
  ]
}
