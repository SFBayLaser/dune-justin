#include "standard_reco1_dune10kt.fcl"

process_name: Reco1

services: 
{
    @table::services
    @table::dunefd_1x2x6_reco_services
}

physics.producers:
{
    @table::physics.producers
    wclsmcnfsp: @local::dune10kt_1x2x6_mc_nfsp
}

# Default is the "fast" version
physics.producers.cluster3d.Hit3DBuilderAlg: @local::standard_snippethit3dbuilderDUNE
#physics.producers.cluster3d.Hit3DBuilderAlg.SaveBadChannelPairs: false

# reset the gaushit long hits
physics.producers.gaushit.LongMaxHits:    [25,25,25]
physics.producers.gaushit.LongPulseWidth: [10,10,10]
physics.producers.gaushit.MaxMultiHit:    8
