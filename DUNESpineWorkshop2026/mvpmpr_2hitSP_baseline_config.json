{
  "workflow": {
    "description": "FD HD MPVMPR baseline Cluster3D SP",
    "monte_carlo": 10
  },
  "defaults": {
    "repo": "SFBayLaser/dune-justin",
    "ref": "main",
    "lifetime_days": 4,
    "max_distance": 60,
    "dunesw_version": "v10_24_00d00",
    "fhicl_files": "https://raw.githubusercontent.com/SFBayLaser/dune-justin/main/bundles/fhicl_bundle.tgz",
    "tarfile_dir": "/cvmfs/fifeuser1.opensciencegrid.org/sw/dune/4de2fb4d19f920807e0a8e8b5b93dbea2c08229c"
  },
  "stages": [
    {
      "id": 1,
      "jobscript": "MCJobSubmission/gen.jobscript",
      "wall_seconds": 14400,
      "rss_mib": 4000,
      "env": {
        "NEVENTS": "20",
        "RUN_BASE": "320000",
        "JOB_FHICL_FILE": "mpvmpr_gen_1x2x6.fcl"
      },
      "output_pattern_next_stage": "*_gen.root"
    },
    {
      "id": 2,
      "jobscript": "MCJobSubmission/g4.jobscript",
      "wall_seconds": 28800,
      "rss_mib": 4000,
      "env": {
        "JOB_FHICL_FILE": "standard_g4_dune10kt_1x2x6.fcl"
      },
      "output_pattern_next_stage": "*_g4.root"
    },
    {
      "id": 3,
      "jobscript": "MCJobSubmission/detsim.jobscript",
      "wall_seconds": 28800,
      "rss_mib": 4000,
      "env": {
        "JOB_FHICL_FILE": "standard_detsim_dune10kt_1x2x6.fcl"
      },
      "output_pattern_next_stage": "*_detsim.root",
      "output_patterns": [
        "*_detsim.root"
      ],
      "output_rse_expression": "DUNE_US_FNAL_DISK_STAGE",
      "lifetime_days": 14
    },
    {
      "id": 4,
      "jobscript": "MCJobSubmission/reco_rcds.jobscript",
      "wall_seconds": 28800,
      "rss_mib": 4000,
      "env": {
        "JOB_FHICL_FILE": "standard_mythical_supera_dune10kt_1x2x6_baseline.fcl"
      },
      "output_patterns": [
        "*_reco.root",
        "*_larcv.root"
      ],
      "output_rse_expression": "DUNE_US_FNAL_DISK_STAGE",
      "lifetime_days": 90
    }
  ]
}
